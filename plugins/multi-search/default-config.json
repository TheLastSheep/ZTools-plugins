          {
            "id": "engine_duckduckgo",
            "name": "DuckDuckGo",
            "url": "https://duckduckgo.com/?q={q}"
          },
          {
            "id": "engine_yandex",
            "name": "Yandex",
            "url": "https://yandex.com/search/?text={q}"
          },
          {
            "id": "engine_sogou",
